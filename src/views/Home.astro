---
import Base from '../layouts/Base.astro';
import { ui } from '../i18n/ui';
import { localePath, type Locale } from '../lib/paths';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);
const tiles = [
  { href: '/research/', label: t.research, klass: 'cell-research fill-red' },
  { href: '/projects/', label: t.projects, klass: 'cell-projects wash' },
  { href: '/garden/', label: t.garden, klass: 'cell-garden fill-yellow' },
  { href: '/journal/', label: t.journal, klass: 'cell-journal fill-blue' },
  { href: '/about/', label: t.about, klass: 'cell-about wash-2' },
  { href: '/interests/', label: t.interests, klass: 'cell-interests wash' },
  { href: '/resume/', label: t.resume, klass: 'cell-resume wash-2' },
  { href: '/contact/', label: t.contact, klass: 'cell-contact fill-blue' },
];
---

<Base locale={locale} title={t.siteTitle} description={t.siteDescription} unlocalizedPath="/">
  <div class="mondrian">
    <section class="cell cell-name">
      <p class="kicker">{t.heroAlt}</p>
      <h1>Siyuan Hui</h1>
      <p class="hero-hello">{t.heroTitle}</p>
      <p class="hero-motto">
        <span class="hero-sub" lang="la">{t.heroSubtitle}</span>
        <span class="hero-sub-companion" lang="zh-CN">{t.heroMottoCompanion}</span>
      </p>
      <p class="hero-intro">{t.heroIntro}</p>
      <p class="meta">{t.heroAffiliation}</p>
      <p class="meta">{t.heroInterests}</p>
    </section>
    {
      tiles.map((tile) => (
        <a class:list={['cell', tile.klass]} href={localePath(locale, tile.href)}>
          <span class="cell-title">{tile.label}</span>
        </a>
      ))
    }
  </div>
</Base>
