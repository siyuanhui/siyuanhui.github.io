---
import Base from '../layouts/Base.astro';
import { byOrder, loadCollection, localize } from '../lib/content';
import { ui } from '../i18n/ui';
import { localePath, type Locale } from '../lib/paths';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = ui(locale);
const entries = byOrder(localize(await loadCollection('research'), locale).map((item) => item.entry));
const spans = ['span-7', 'span-5', 'span-8', 'span-6', 'span-6', 'span-4'];
const washes = ['wash', '', 'wash-2', '', 'wash', ''];
---

<Base locale={locale} title={t.pageTitle(t.research)} description={t.researchIntro} unlocalizedPath="/research/">
  <div class="board">
    <header class="block span-5 fill-red block-end">
      <h1>{t.research}</h1>
    </header>
    <p class="block span-7 lede">{t.researchIntro}</p>
    {
      entries.map((entry, index) => (
        <a class:list={['block', spans[index % spans.length], washes[index % washes.length]]} href={localePath(locale, `/research/${entry.data.translationKey}/`)}>
          <p class="meta">{[entry.data.role, entry.data.period].filter(Boolean).join(' · ')}</p>
          <h2>{entry.data.title}</h2>
          <p>{entry.data.description}</p>
          {entry.data.facts[0] && <p class="meta">{entry.data.facts[0]}</p>}
        </a>
      ))
    }
    <div class="block span-4 fill-blue field" aria-hidden="true"></div>
  </div>
</Base>
