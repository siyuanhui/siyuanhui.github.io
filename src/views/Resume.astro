---
import Base from '../layouts/Base.astro';
import { links } from '../data/links';
import { resumeHref } from '../lib/files';
import { ui } from '../i18n/ui';
import type { Locale } from '../lib/paths';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = ui(locale);
const pdf = resumeHref();
---

<Base locale={locale} title={t.pageTitle(t.resume)} description={pdf ? `${t.resume} — Siyuan Hui (PDF)` : t.resumePending} unlocalizedPath="/resume/">
  <div class="board">
    <header class="block span-7 block-end">
      <h1>{t.resume}</h1>
    </header>
    {
      pdf ? (
        <a class="block span-5 fill-red block-end" href={pdf}>{t.resumeDownload}</a>
      ) : (
        <div class="block span-5">
          <p>{t.resumePending}</p>
          <p>{t.resumeAsk}</p>
        </div>
      )
    }
    <a class="block span-3" href={`mailto:${links.email}`}>{links.email}</a>
    <a class="block span-3 wash" href={links.github}>GitHub</a>
    <a class="block span-3" href={links.linkedin}>LinkedIn</a>
    <a class="block span-3 fill-yellow" href={links.x}>X</a>
    {pdf && <iframe class="resume-frame span-12" src={pdf} title={t.resume}></iframe>}
  </div>
</Base>
