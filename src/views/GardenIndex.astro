---
import Base from '../layouts/Base.astro';
import { courses } from '../data/courses';
import { topics } from '../data/topics';
import { featuredFirst, loadCollection, localize } from '../lib/content';
import { ui } from '../i18n/ui';
import { formatDate } from '../lib/reading';
import { localePath, type Locale } from '../lib/paths';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = ui(locale);
const notes = featuredFirst(localize(await loadCollection('garden'), locale).map((item) => item.entry));
const tones = ['', 'wash', 'fill-yellow', '', 'fill-red', 'wash-2', '', 'fill-blue'];

const topicGroups = topics.map((topic, index) => {
  const items = notes.filter((note) => note.data.topic === topic.id);
  const latest = items[0]?.data.date;
  return { topic, items, latest, tone: tones[index % tones.length] };
});
---

<Base locale={locale} title={t.pageTitle(t.garden)} description={t.gardenIntro} unlocalizedPath="/garden/">
  <div class="board">
    <header class="block span-7 block-end">
      <h1>{t.garden}</h1>
    </header>
    <p class="block span-5 lede">{t.gardenIntro}</p>
    <a class:list={['block', 'tile', 'span-4', 'fill-blue']} href={localePath(locale, '/garden/courses/')}>
      <p class="meta">{t.courseCount(courses.length)}</p>
      <h2>{t.coursework}</h2>
    </a>
    {
      topicGroups.map((group) => {
        const label = locale === 'zh' ? group.topic.zh : group.topic.en;
        const count = group.items.length;
        const klass = ['block', 'tile', 'span-4'];
        if (count > 0) {
          const fills = ['fill-yellow', 'fill-red', 'wash', 'fill-blue'];
          const populatedIndex = topicGroups.filter((item) => item.items.length > 0).findIndex((item) => item.topic.id === group.topic.id);
          klass.push(fills[populatedIndex % fills.length] ?? group.tone);
          const meta = [t.noteCount(count), group.latest ? formatDate(group.latest, locale) : undefined].filter(Boolean).join(' · ');
          return (
            <a class:list={klass} href={localePath(locale, `/garden/${group.topic.id}/`)}>
              <p class="meta">{meta}</p>
              <h2>{label}</h2>
            </a>
          );
        }
        return (
          <div class:list={[...klass, 'is-empty']}>
            <p class="meta">{t.nothingHere}</p>
            <h2>{label}</h2>
          </div>
        );
      })
    }
    {
      import.meta.env.DEV && (
        <p class="block span-4 notice">
          <a href={localePath(locale, '/garden/template-technical-note/')}>template-technical-note</a>
        </p>
      )
    }
  </div>
</Base>
