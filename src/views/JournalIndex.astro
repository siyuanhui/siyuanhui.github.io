---
import Base from '../layouts/Base.astro';
import { journalCategories } from '../data/journal';
import { featuredFirst, loadCollection, localize } from '../lib/content';
import { ui } from '../i18n/ui';
import { formatDate } from '../lib/reading';
import { localePath, type Locale } from '../lib/paths';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = ui(locale);
const entries = featuredFirst(localize(await loadCollection('journal'), locale).map((item) => item.entry));
const tones = ['', 'wash', 'fill-yellow', '', 'wash-2', 'fill-red', '', 'wash', 'fill-blue'];

const groups = journalCategories.map((category, index) => {
  const items = entries.filter((entry) => entry.data.category === category.id);
  const latest = items[0]?.data.date;
  return { category, items, latest, tone: tones[index % tones.length] };
});
---

<Base locale={locale} title={t.pageTitle(t.journal)} description={t.journalIntro} unlocalizedPath="/journal/">
  <div class="board">
    <header class="block span-7 block-end">
      <h1>{t.journal}</h1>
    </header>
    <p class="block span-5 lede">{t.journalIntro}</p>
    {
      groups.map((group) => {
        const label = locale === 'zh' ? group.category.zh : group.category.en;
        const count = group.items.length;
        const klass = ['block', 'tile', 'span-4'];
        if (count > 0) {
          const fills = ['fill-yellow', 'fill-blue', 'fill-red', 'wash'];
          const populatedIndex = groups.filter((item) => item.items.length > 0).findIndex((item) => item.category.id === group.category.id);
          klass.push(fills[populatedIndex % fills.length] ?? group.tone);
          const meta = [t.entryCount(count), group.latest ? formatDate(group.latest, locale) : undefined].filter(Boolean).join(' · ');
          return (
            <a class:list={klass} href={localePath(locale, `/journal/${group.category.id}/`)}>
              <p class="meta">{meta}</p>
              <h2>{label}</h2>
            </a>
          );
        }
        return (
          <div class:list={[...klass, 'is-empty']}>
            <p class="meta">{t.nothingHere}</p>
            <h2>{label}</h2>
          </div>
        );
      })
    }
  </div>
</Base>
