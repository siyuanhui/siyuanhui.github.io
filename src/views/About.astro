---
import Base from '../layouts/Base.astro';
import { courseSlug, courses } from '../data/courses';
import profile from '../data/profile.json';
import { publicFileExists } from '../lib/files';
import { ui } from '../i18n/ui';
import { localePath, type Locale } from '../lib/paths';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = ui(locale);
const bio = profile[locale];
const transcript = publicFileExists('/transcript.pdf') ? '/transcript.pdf' : null;
const skillGroups = [
  [t.programming, bio.skills.programming],
  [t.toolsLabel, bio.skills.tools],
  [t.languages, bio.skills.languages],
] as const;
const eduSpan = ['span-8', 'span-7', 'span-5'];
const teachSpan = ['span-5', 'span-4'];
---

<Base locale={locale} title={t.pageTitle(t.about)} description={bio.about[0]} unlocalizedPath="/about/">
  <div class="board">
    <header class="block span-5 block-end">
      <p class="kicker">{t.about}</p>
      <h1>{t.about}</h1>
    </header>
    <div class="block span-7">
      {bio.about.map((paragraph) => <p>{paragraph}</p>)}
      <p class="more"><a href={localePath(locale, '/now/')}>{t.fullNow}</a></p>
    </div>

    <section id="education" class="block span-4 fill-red block-end">
      <h2>{t.education}</h2>
    </section>
    {
      bio.education.map(([name, role, dates, note], index) => (
        <article class:list={['block', eduSpan[index] ?? 'span-6', index === 2 && 'wash']}>
          <div class="edu-head">
            <h3>{name}</h3>
            <p class="when">{dates}</p>
          </div>
          <p class="meta">{role}</p>
          <p>{note}</p>
        </article>
      ))
    }

    <section class="block span-8">
      <h3 class="group-label">{t.relevantCoursework}</h3>
      <ul>
        {courses.filter((course) => !course.progress).map((course) => (
          <li><a href={localePath(locale, `/garden/courses/${courseSlug(course.code)}/`)}>{locale === 'zh' ? course.zh : course.en}</a></li>
        ))}
      </ul>
      <p class="more">
        {transcript && <a href={transcript}>{t.transcript}</a>}
        <a href={localePath(locale, '/garden/courses/')}>{t.courseworkArchive}</a>
      </p>
    </section>
    <section class="block span-4 fill-yellow">
      <h3 class="group-label">{t.inProgressHeading}</h3>
      <ul>
        {courses.filter((course) => course.progress).map((course) => (
          <li><a href={localePath(locale, `/garden/courses/${courseSlug(course.code)}/`)}>{locale === 'zh' ? course.zh : course.en}</a></li>
        ))}
      </ul>
    </section>

    <section id="teaching" class="block span-3 fill-blue block-end">
      <h2>{t.teaching}</h2>
    </section>
    {
      bio.teaching.map((item, index) => {
        const Tag = item.href ? 'a' : 'article';
        const extras = item.href ? { href: localePath(locale, item.href) } : {};
        return (
          <Tag class:list={['block', teachSpan[index] ?? 'span-4', index === 1 && 'wash-2']} {...extras}>
            {item.award && <p class="award-tag">{item.award}</p>}
            <div class="edu-head">
              <h3>{item.title}</h3>
              <p class="when">{item.period}</p>
            </div>
            <p class="meta">{item.org}</p>
            {item.body && <p>{item.body}</p>}
          </Tag>
        );
      })
    }

    <section id="skills" class="block span-3 block-end wash-2">
      <h2>{t.skills}</h2>
    </section>
    {skillGroups.map(([label, items], index) => (
      <div class:list={['block', 'span-3', index === 1 && 'wash']}>
        <h3 class="group-label">{label}</h3>
        <p>{items.join(', ')}</p>
      </div>
    ))}
  </div>
</Base>
