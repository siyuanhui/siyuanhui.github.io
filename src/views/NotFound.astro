---
import Base from '../layouts/Base.astro';
import { ui } from '../i18n/ui';
import { localePath } from '../lib/paths';

const t = ui('en');
const zh = ui('zh');
---

<Base
  locale="en"
  title="Page not found — Siyuan Hui"
  description={t.notFoundBody}
  unlocalizedPath="/404/"
  langPaths={{ en: '/', zh: '/zh/' }}
  noindex={true}
>
  <div class="board">
    <header class="block span-7 block-end">
      <h1>{t.notFound}</h1>
      <p>{t.notFoundBody}</p>
    </header>
    <div class="block span-5 fill-red">
      <p class="hero-links">
        <a href={localePath('en', '/')}>{t.home}</a>
        <a href={localePath('en', '/projects/')}>{t.projects}</a>
        <a href={localePath('en', '/research/')}>{t.research}</a>
        <a href={localePath('en', '/garden/')}>{t.garden}</a>
        <a href={localePath('en', '/journal/')}>{t.journal}</a>
        <a href={localePath('en', '/about/')}>{t.about}</a>
      </p>
    </div>
    <header class="block span-7" lang="zh-CN">
      <h2>{zh.notFound}</h2>
      <p>{zh.notFoundBody}</p>
    </header>
    <div class="block span-5 fill-blue" lang="zh-CN">
      <p class="hero-links">
        <a href={localePath('zh', '/')}>{zh.home}</a>
        <a href={localePath('zh', '/projects/')}>{zh.projects}</a>
        <a href={localePath('zh', '/about/')}>{zh.about}</a>
      </p>
    </div>
  </div>
</Base>
