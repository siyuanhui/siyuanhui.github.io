---
import Base from '../layouts/Base.astro';
import { ui } from '../i18n/ui';
import { localePath } from '../lib/paths';

const t = ui('en');
const zh = ui('zh');
---

<Base
  locale="en"
  title="Page not found — Siyuan Hui"
  description={t.notFoundBody}
  unlocalizedPath="/404/"
  langPaths={{ en: '/', zh: '/zh/' }}
  noindex={true}
>
  <article class="wrap page-header" style="padding-bottom: 4rem;">
    <h1>{t.notFound}</h1>
    <p>{t.notFoundBody}</p>
    <p class="hero-links">
      <a href={localePath('en', '/')}>{t.home}</a>
      <a href={localePath('en', '/projects/')}>{t.projects}</a>
      <a href={localePath('en', '/research/')}>{t.research}</a>
      <a href={localePath('en', '/garden/')}>{t.garden}</a>
      <a href={localePath('en', '/journal/')}>{t.journal}</a>
      <a href={localePath('en', '/about/')}>{t.about}</a>
    </p>
    <h2 lang="zh-CN" style="margin-top: 2.5rem;">{zh.notFound}</h2>
    <p lang="zh-CN">{zh.notFoundBody}</p>
    <p class="hero-links" lang="zh-CN">
      <a href={localePath('zh', '/')}>{zh.home}</a>
      <a href={localePath('zh', '/projects/')}>{zh.projects}</a>
      <a href={localePath('zh', '/about/')}>{zh.about}</a>
    </p>
  </article>
</Base>
