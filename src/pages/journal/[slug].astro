---
import { isJournalCategory } from '../../data/journal';
import { journalStaticPaths } from '../../lib/content';
import JournalCategory from '../../views/JournalCategory.astro';
import View from '../../views/Writing.astro';

export async function getStaticPaths() {
  return journalStaticPaths();
}

const { slug } = Astro.params;
---

{isJournalCategory(slug!) ? <JournalCategory locale="en" slug={slug!} /> : <View locale="en" slug={slug!} collection="journal" />}
