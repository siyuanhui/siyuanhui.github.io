---
import { isGardenTopic } from '../../data/topics';
import { gardenStaticPaths } from '../../lib/content';
import GardenTopic from '../../views/GardenTopic.astro';
import View from '../../views/Writing.astro';

export async function getStaticPaths() {
  return gardenStaticPaths();
}

const { slug } = Astro.params;
---

{isGardenTopic(slug!) ? <GardenTopic locale="en" slug={slug!} /> : <View locale="en" slug={slug!} collection="garden" />}
